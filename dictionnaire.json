  "source": "ALK"
 },
 {
  "category": "proverbes",
  "flag": "",
  "fr": "Savoir s'humilier devant les plus anciens.",
  "naa": "Nô titè ngwajè kô wanyerä.",
  "note": "dicton",
  "source": "ALK"
 },
 {
  "category": "proverbes",
  "flag": "",
  "fr": "La langue est source de vie.",
  "naa": "Nââ nuu ö gï, yi vemoore taa kotre.",
  "note": "dicton",
  "source": "ALK"
 },
 {
  "category": "proverbes",
  "flag": "",
  "fr": "Savoir appréhender le bon moment pour s'élancer.",
  "naa": "Nô treké kwè, nô treké karè.",
  "note": "dicton",
  "source": "ALK"
 },
 {
  "category": "proverbes",
  "flag": "",
  "fr": "Chaque jour, son histoire.",
  "naa": "Taa nyii bwa yia ngà vï ö rë.",
  "note": "dicton",
  "source": "ALK"
 },
 {
  "category": "proverbes",
  "flag": "",
  "fr": "Doucement mais sûrement.",
  "naa": "Nô wè kee, nô wè kwè.",
  "note": "dicton",
  "source": "ALK"
 },
