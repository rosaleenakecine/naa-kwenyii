  "source": "ALK"
 },
 {
  "category": "proverbes",
  "flag": "",
  "fr": "La folie des grandeurs ne guérit pas les maux.",
  "naa": "Nowé vëcape nokô a gï nô yuuè taa nyii.",
  "note": "dicton",
  "source": "ALK"
 },
 {
  "category": "proverbes",
  "flag": "",
  "fr": "Il faut savoir gérer son temps.",
  "naa": "Nô vangà mô karè, nô vangà kaa karè.",
