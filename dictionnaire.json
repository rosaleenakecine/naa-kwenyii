  "source": "ALK"
 },
 {
  "category": "expressions",
  "flag": "",
  "fr": "Quelle heure est-il ?",
  "naa": "Yi ré tré ngèrànyii ngà rà ?",
  "note": "",
  "source": "ALK"
 },
 {
  "category": "expressions",
  "flag": "",
  "fr": "Il dort.",
